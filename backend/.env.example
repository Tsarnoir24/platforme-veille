# Configuration serveur & base de données
PORT=3000
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=veille

# JWT & Sessions
JWT_SECRET=
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
FRONTEND_URL=http://localhost:5173

# Compte administrateur initial (Seed TypeORM)
SEED_ADMIN_EMAIL=admin@veille.local
SEED_ADMIN_PASSWORD=

# Analyse IA des veilles — désactivée par défaut.
AI_ENABLED=false
AI_ALLOW_EXTERNAL_PROCESSING=false
AI_AUTO_ANALYZE=false

# Fournisseur actif : auto, openai, gemini, claude, deepseek ou groq.
AI_PROVIDER=openai
AI_FALLBACK_PROVIDERS=gemini,claude,deepseek,openai
AI_MAX_KEY_ATTEMPTS=2
AI_ALLOW_MANUAL_FAILOVER=false

# Clés d'API (renseigner uniquement le fournisseur choisi)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

AI_LABORATORY_CONTEXT=Laboratoire d’essais et d’étalonnage engagé dans une démarche ISO/IEC 17025.
AI_REQUEST_TIMEOUT_MS=45000

# DeepL : une clé ou plusieurs clés séparées par des virgules.
DEEPL_API_KEY=
DEEPL_API_KEYS=

# SMTP / Courriels
ENABLE_EMAIL=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=no-reply@plateforme-veille.com
